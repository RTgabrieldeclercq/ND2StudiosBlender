# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# NodeLab / ND2Studios outputs
results/
*.nd2s
*.nd2s_pipeline.json.bak

# Local sample data (large microscopy files — never commit)
sample_data/
*.nd2

# Derived caches — both are rebuildable from the source file / the graph, and both are
# the size of the data rather than the size of the code.
*.b2nd_store/
*.docks/

# Trained weights. A ZS-DeconvNet checkpoint is ~50 MB of .h5 per channel, it is the size
# of the data rather than the size of the code, and it is reproducible by re-running the
# node on the file it was trained on. The sidecar JSON `nodegraph.trained` reads is only
# meaningful next to its weights, so the whole directory goes.
models/

# Working graphs saved at the repo root. These carry absolute paths into the operator's own
# Desktop/Downloads, so they are personal scratch, not shippable examples — the pipelines
# that ARE shipped live under `lablink_recipes/` and are matched by the anchored pattern.
/*.nd2graph.json

# Ad-hoc analysis dumps written by hand while auditing the catalog. Nothing reads them.
/shared_detail.json
nodelab_v2/scratch_none

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# evidence-log: the record is log.jsonl + img/ + evidence_log.md and IS committed.
# These are regenerable in one command each, and are the size of the data.
CodeLog/live/evidence_archive.html
CodeLog/live/label/img/
# Ground truth: the hand-drawn ANSWER (gt/*.json) is irreplaceable and is committed. The
# tiles and the annotator page are rebuilt by `python scripts/_gt_tiles.py` and are ~23 MB.
CodeLog/live/gt/img/
CodeLog/live/gt/index.html
